{
  "name": "voxelspy",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "dev": "turbo run dev --parallel",
    "format": "git ls-files -z | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z | xargs -0 prettier --check --ignore-unknown",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  }
}
